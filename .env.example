# ── LLM (required) ────────────────────────────────────────────────────────────
# UltimateScrape talks to Kimi K2.6 through OpenRouter by default.
# KIMI_API_KEY is accepted as an alias; OPENROUTER_API_KEY wins if both are set.
OPENROUTER_API_KEY=sk-or-v1-...
# KIMI_API_KEY=sk-or-v1-...

# Model fallback chain, tried left to right. First one that returns non-empty
# content wins. Kimi burns reasoning tokens, so an "empty content" response is
# a budget problem, not a model problem — the client doubles max_tokens and
# retries before demoting to the next model.
USCRAPE_MODELS=moonshotai/kimi-k2.6,moonshotai/kimi-k2.5,google/gemma-4-31b-it

# Direct Moonshot instead of OpenRouter (no server-side web search available).
# MOONSHOT_API_KEY=sk-...
# USCRAPE_LLM_BASE_URL=https://api.moonshot.ai/v1

# NVIDIA NIM — free Kimi tier, useful for ungrounded calls only.
# vLLM rejects server-side search tools, so NIM can never web-search.
# NVIDIA_NIM_API_KEY=nvapi-...
# NIM_KEY_1=nvapi-...      # numbered keys are pooled round-robin for rate limits
# NIM_EXTRA_KEYS=nvapi-...,nvapi-...

# ── Spend guards ──────────────────────────────────────────────────────────────
USCRAPE_MAX_RUN_COST_USD=25.0     # hard ceiling; the swarm aborts when reached
USCRAPE_MIN_CREDITS_USD=5.0       # pre-flight OpenRouter balance floor

# ── Concurrency ───────────────────────────────────────────────────────────────
USCRAPE_LLM_CONCURRENCY=12
USCRAPE_FETCH_CONCURRENCY=20
USCRAPE_PER_HOST_CONCURRENCY=4
USCRAPE_PER_HOST_DELAY_S=1.0
USCRAPE_AGENT_TIMEOUT_S=300
USCRAPE_RUN_DEADLINE_S=3600

# ── Web search (for grounded agents) ──────────────────────────────────────────
# OpenRouter's server-side tool needs no key. These are the client-side fallbacks.
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_CONTEXT_SIZE=low
# TAVILY_API_KEY=tvly-...
# BRAVE_SEARCH_API_KEY=BSA...
# EXA_API_KEY=...

# ── Statistics / census APIs ──────────────────────────────────────────────────
# Free key, instant issue: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# https://www.bls.gov/developers/home.htm
BLS_API_KEY=
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# https://apps.bea.gov/API/signup/
BEA_API_KEY=
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
# https://portail-api.insee.fr/
INSEE_API_KEY=
# https://api.data.gov.in/
DATA_GOV_IN_API_KEY=
# https://www.e-stat.go.jp/api/
ESTAT_APP_ID=
# https://kosis.kr/openapi/
KOSIS_API_KEY=
# https://www.inegi.org.mx/servicios/api_indicadores.html
INEGI_API_TOKEN=
# https://api.opencorporates.com/
OPENCORPORATES_API_KEY=
# SEC requires a descriptive UA with contact email on every request.
SEC_USER_AGENT=UltimateScrape research (you@example.com)

# ── LinkedIn (read docs/LINKEDIN.md before enabling tiers 2 or 3) ────────────
# Tier order; each tier is skipped when unconfigured. "parser" is deliberately
# omitted from the default — opt in only after reading the risk note.
USCRAPE_LINKEDIN_TIERS=vendor,mcp,parser,jina

# Tier 1 — paid vendor APIs. Highest cost per record, no account risk, scales.
# PROXYCURL_API_KEY=
# BRIGHTDATA_API_TOKEN=
# APIFY_API_TOKEN=

# Tier 2 — self-hosted stickerdaniel/linkedin-mcp-server (Patchright + a
# persistent profile). The only self-hosted backend whose employee list and
# people search actually work.
# LINKEDIN_MCP_URL=http://localhost:3000/mcp

# Tier 3 — our own Patchright browser + joeyism/linkedin_scraper's parsers.
#   uv pip install "linkedin-scraper>=3.1" patchright && patchright install chromium
# Prefer a persistent profile over a raw cookie: LinkedIn invalidates a li_at
# lifted across an OS or fingerprint boundary (upstream issue #279), so a cookie
# copied from your desktop will not authenticate inside a container.
# LINKEDIN_PROFILE_DIR=~/.uscrape/linkedin-profile-acct1
# LINKEDIN_LI_AT=
# USCRAPE_LINKEDIN_HEADLESS=true   # set false once, headed, to clear a checkpoint

# Tier 4 — Jina Reader, public pages only, no key needed.
JINA_READER_BASE=https://r.jina.ai
# JINA_API_KEY=

# ── Proxies (optional) ────────────────────────────────────────────────────────
# USCRAPE_PROXY_URL=http://user:pass@host:port
# USCRAPE_PROXY_POOL=http://a:1,http://b:2
